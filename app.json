{
  "expo": {
    "name": "Gowri Toys",
    "slug": "gowri-toys",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gowritoys",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Gowri Toys uses the camera to scan worker QR codes for attendance."
      }
    },
    "android": {
      "backgroundColor": "#F6F6F4",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Gowri Toys uses the camera to scan worker QR codes for attendance."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gowri Toys uses your photo library to set a profile photo for a worker."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Gowri Toys to save worker ID card images to your photo library.",
          "savePhotosPermission": "Allow Gowri Toys to save worker ID card images to your photo library."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F46E5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}